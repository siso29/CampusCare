# CampusCare Backend Environment Configuration Template
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# Cross-Origin Resource Sharing (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campuscare
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campuscare_test

# Authentication & Sessions
SESSION_COOKIE_NAME=campuscare_session
SESSION_SECRET=replace_with_strong_random_secret_at_least_32_characters
SESSION_TTL_DAYS=7
CSRF_COOKIE_NAME=campuscare_csrf

# Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Logging
LOG_LEVEL=info

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880

# Super Admin / Initial Bootstrap Credentials
SUPER_ADMIN_EMAIL=admin@ddu.edu.et
SUPER_ADMIN_PASSWORD=ChangeMe123!
